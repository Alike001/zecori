[Unit]
Description=Zecori one-shot signed private verification relay
After=network-online.target zecori-zecd-watch.service
Requires=zecori-zecd-watch.service

[Service]
Type=oneshot
User=zecori-verifier
Group=zecori-verifier
WorkingDirectory=/opt/zecori/app
# relay.env contains only endpoint configuration and private-file paths. Keep it
# mode 0600 and never put key bodies, a UFVK, or a mnemonic in the environment.
EnvironmentFile=/etc/zecori-verifier/relay.env
ExecStart=/usr/bin/corepack pnpm verifier:relay
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ReadOnlyPaths=/opt/zecori/app /etc/zecori-verifier /var/lib/zecori-zecd /run/zecori-zecd


# Public, non-secret deployment values only. Do not put credentials in this file.
DOMAIN=swap.example.org
# Private database encryption keys are supplied through the mode-0600
# ZECATHON_ENCRYPTION_KEY_FILE (or the Compose encryption_keyring secret), not here.
# Read-only Base Sepolia RPC. Use a production-grade provider endpoint in deployment;
# the official public endpoint is rate-limited and is only the safe default.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# First release is EOA-only. Do not enable until a deployed Base Sepolia
# contract wallet has passed the documented live validation and review gate.
ZECATHON_ERC1271_ENABLED=0

# Optional Privy authentication. Disabled unless explicitly set to 1.
# The browser receives only PRIVY_APP_ID. Keep the dashboard verification key
# in a mode-0600 file outside the repository; this integration never needs a
# wallet signing secret and does not enable embedded/delegated wallets.
PRIVY_AUTH_ENABLED=0
# PRIVY_APP_ID=replace-with-dashboard-app-id
# PRIVY_VERIFICATION_KEY_FILE=/run/secrets/privy-verification-key.pem

# Optional server-side AI. Without these values the assistant reports limited mode.
# Keep credentials out of this file. In production mount a mode-0600 credential file.
# AI_PROVIDER=openai-responses
# AI_MODEL=replace-with-approved-model
# AI_BASE_URL=https://api.openai.com/v1
# Groq alternative (do not set both provider configurations):
# AI_PROVIDER=groq-responses
# AI_MODEL=openai/gpt-oss-20b
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY_FILE=/run/secrets/ai_api_key
# AI_MAX_OUTPUT_TOKENS=600
# AI_MAX_PROVIDER_CALLS=3
# AI_AGENT_REQUESTS_PER_MINUTE=10
# Deliberately set only after reviewing budget and retention disclosures:
# AI_EXTERNAL_REQUESTS_APPROVED=I_APPROVE_CHARGEABLE_MODEL_REQUESTS

# Optional authenticated Groq speech. Reuses the server-only Groq key above and
# remains off unless both flags are exact. Uploaded audio is limited to 2 MB /
# 30 seconds and held only in process memory until the provider responds.
VOICE_ENABLED=0
# VOICE_EXTERNAL_REQUESTS_APPROVED=I_APPROVE_CHARGEABLE_SPEECH_REQUESTS
# Set only after a reviewer runs the opt-in live validation and records results:
# VOICE_PROVIDER_LIVE_VALIDATED=0
